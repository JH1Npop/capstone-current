{
  "name": "capstone-full-stack",
  "version": "1.0.0",
  "description": "Unified AFN Service Management Dashboard",
  "scripts": {
    "build": "npm --prefix frontend run build && node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.cpSync('frontend/dist','dist',{recursive:true});\"",
    "build:pythonanywhere": "npm --prefix frontend run build:pythonanywhere",
    "dev": "npm --prefix frontend run dev",
    "dev:full": "npm --prefix frontend run dev:full",
    "check:backend": "cd backend && ..\\venv\\Scripts\\python.exe manage.py check",
    "test:backend": "cd backend && ..\\venv\\Scripts\\python.exe manage.py test",
    "build:frontend": "cd frontend && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/01-public-pages.spec.js e2e/02-authentication.spec.js",
    "quality": "node scripts/release-gate.mjs",
    "quality:full": "node scripts/release-gate.mjs --full-e2e",
    "quality:staging": "node scripts/staging-gate.mjs"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
