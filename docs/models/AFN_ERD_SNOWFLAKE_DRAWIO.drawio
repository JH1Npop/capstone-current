        <mxCell id="e1" value="1 request creates N tickets" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#334155;fontSize=10;" edge="1" parent="1" source="request" target="ticket"><mxGeometry relative="1" as="geometry"/></mxCell>
