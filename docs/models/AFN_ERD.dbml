Table services_serviceticket {
  service_ticket_id bigint [pk, increment]
  request_id bigint [not null, ref: > services_servicerequest.service_request_id]
  ticket_type varchar(20) [not null]
  technician_id bigint [ref: > users_user.user_id]
  assigned_admin_id bigint [ref: > users_user.user_id]
  scheduled_date date [not null]
  scheduled_time time
  scheduled_time_slot varchar(20)
  start_time timestamp
  end_time timestamp
  completed_date timestamp
  status varchar(50) [not null]
  priority varchar(50) [not null]
  notes text
  client_rating integer
  client_feedback text
  auto_assigned boolean [not null]
  assigned_at timestamp
  smart_assignment_score double
  smart_assignment_summary varchar(255)
  project_details text [not null]
  reschedule_requested boolean [not null]
  reschedule_reason text
  reschedule_requested_at timestamp
  warranty_status varchar(20) [not null]
  warranty_period_days integer
  warranty_start_date date
  warranty_end_date date
  warranty_notes text
  route_geometry text
  route_distance double
  route_duration double
  completion_proof_images text [not null]
  completion_notes text
  created_at timestamp
  updated_at timestamp

  Indexes {
    (status, scheduled_date)
    (technician_id, status)
    (assigned_admin_id, status)
    (assigned_admin_id, created_at)
    (completed_date)
    (scheduled_date, scheduled_time)
    (status, created_at)
    (auto_assigned, assigned_at)
  }
}

