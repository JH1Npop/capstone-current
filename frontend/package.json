{
  "name": "afn-service-management",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --configLoader runner --host 127.0.0.1",
    "dev:full": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\dev-full.ps1",
