# Django
DJANGO_ENV=production
DEPLOYMENT_STAGE=production
DEBUG=False
ENABLE_HTTPS=True
SECRET_KEY=replace-with-a-real-secret-key
# Set a stable Fernet key before enrolling real administrator MFA. If omitted,
# encryption derives from SECRET_KEY and rotating SECRET_KEY requires disabling
# MFA before the rotation.
# MFA_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
MFA_ISSUER_NAME=AFN Service Management
LOG_FORMAT=json
ALLOWED_HOSTS=your-backend.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend.netlify.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.netlify.app
FRONTEND_BASE_URL=https://your-frontend.netlify.app
USE_X_FORWARDED_PROTO=True
USE_X_FORWARDED_HOST=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Database
# Production accepts DATABASE_URL normally; this override is only needed when a
# non-production environment intentionally connects to a remote database.
ALLOW_REMOTE_DATABASE_IN_DEVELOPMENT=False
DATABASE_URL=postgresql://avnadmin:YOUR_AIVEN_PASSWORD@YOUR_SERVICE.aivencloud.com:12345/defaultdb?sslmode=verify-full
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/run/secrets/aiven-ca.pem
DB_CONNECT_TIMEOUT=10
# Daphne/ASGI should not reuse persistent database sockets. If a different
# synchronous deployment enables persistence, retain the health check.
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=True

# Static and media
STATIC_ROOT=staticfiles
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Set True only when the host provides a persistent media volume and Cloudinary is intentionally unused.
ALLOW_LOCAL_MEDIA_IN_PRODUCTION=False

# Redis is required for cross-process WebSocket delivery in production.
USE_REDIS=True
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:6379/0
CHANNEL_CAPACITY=10000
CHANNEL_EXPIRY_SECONDS=600

# Technician location operations (non-secret)
# Default bounds cover CALABARZON; replace all four edges and the label together.
TRACKING_REGION_NAME=CALABARZON
TRACKING_REGION_SOUTH_LAT=13.38
TRACKING_REGION_WEST_LNG=119.88
TRACKING_REGION_NORTH_LAT=14.96
TRACKING_REGION_EAST_LNG=122.42
TRACKING_REGION_MIN_ZOOM=8
TECHNICIAN_LOCATION_RETENTION_DAYS=30
TECHNICIAN_LOCATION_TRAIL_MINUTES=60

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AFN Service <noreply@example.com>
EMAIL_VERIFICATION_EXPIRY_HOURS=24
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Disposable staging only; production startup rejects this when enabled.
STAGING_AUTO_VERIFY_REGISTRATIONS=False
