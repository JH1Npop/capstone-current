# Django Settings
DJANGO_ENV=development
DEBUG=True
ENABLE_HTTPS=False
SECRET_KEY=replace-with-a-real-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
TIME_ZONE=Asia/Kolkata
STATIC_ROOT=backend/staticfiles
USE_X_FORWARDED_PROTO=False
USE_X_FORWARDED_HOST=False
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Database
DATABASE_ENGINE=sqlite3
SQLITE_DB_PATH=db.sqlite3

# Aiven / PostgreSQL deployment
# Paste the PostgreSQL URI from Aiven here.
# Example:
# DATABASE_URL=postgres://avnadmin:YOUR_AIVEN_PASSWORD@pg-1b16a386-pares4a.h.aivencloud.com:21431/defaultdb?sslmode=require
DATABASE_URL=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60

# OpenRouteService API
OPENROUTESERVICE_API_KEY=replace-with-your-ors-key
ORS_API_KEY=replace-with-your-ors-key
DISABLE_EXTERNAL_ROUTING=False
ROUTING_HTTP_TIMEOUT_SECONDS=8

# Gemini Analytics Explanation
# Optional: when unset, analytics AI summary falls back to local computed text.
GEMINI_API_KEY=
GEMINI_ANALYTICS_MODEL=gemini-3.5-flash

# Email / SMTP
# Use console backend for local no-send debugging:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Use SMTP backend when you want real emails to reach inboxes:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=AFN Service <your_email@gmail.com>

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# Frontend Build
VITE_API_BASE_URL=/api
